resource Member { fields { id: Id } }
actor Member
resource Summary {
  fields { id: Id; owner: Member; neutral_seconds: Int(0..1000000) default database }
  rows read when true
  transition bump { from true; allow owner = actor; to neutral_seconds = neutral_seconds + 1 }
  expose apply bump { target id; bulk maxRows 1 }
  extension write refresh {
    input { id: Summary.Id }
    output { count: Int(0..10) }
    access Summary.bump
    access mongo.youtube_watching_data
    effect db
    deadline 3s
    implementation "worker.refresh"
  }
}
