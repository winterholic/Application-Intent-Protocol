resource Member { fields { id: Id } }
actor Member
resource Video {
  fields { id: Id; owner: Member; views: Int(0..100) default database }
  rows read when true
  transition increment { from views < 100; allow owner = actor; to views = views + 1; notify owner "video.viewed" }
  transition reset { from views > 0; allow owner = actor; to views = 0 }
  expose apply increment { target id; bulk maxRows 1 }
  expose apply reset { target id; bulk maxRows 1 }
  extension write view {
    input { id: Video.Id }
    output { count: Int(0..10) }
    access Video.increment
    effect db
    deadline 5s
    implementation "worker.view"
  }
  extension write twice {
    input { first: Video.Id; second: Video.Id }
    output { count: Int(0..10) }
    access Video.increment
    effect db
    deadline 5s
    implementation "worker.twice"
  }
  extension write badOutput {
    input { id: Video.Id }
    output { count: Int(0..10) }
    access Video.increment
    effect db
    deadline 5s
    implementation "worker.badOutput"
  }
  extension write undeclared {
    input { id: Video.Id }
    output { count: Int(0..10) }
    access Video.increment
    effect db
    deadline 5s
    implementation "worker.undeclared"
  }
}

operation job incrementJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access Video.increment
  effect managed
  deadline 5s
  implementation "worker.jobView"
}
operation job retryJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access Video.increment
  effect managed
  deadline 5s
  implementation "worker.jobRetry"
}
operation job slowJob {
  input {}
  output { count: Int }
  allow actor != null
  effect none
  deadline 10s
  implementation "worker.jobSlow"
}
// Fed by a signed webhook, a schedule and the outbox relay. Users may not enqueue these operations themselves.
operation job hookJob {
  input { body: Text(1..4096) }
  output { count: Int(0..10) }
  allow actor != null
  access Video.increment
  effect managed
  deadline 5s
  implementation "worker.jobHook"
}
operation job tickJob {
  input { note: Text(1..10) }
  output { count: Int(0..10) }
  allow actor != null
  effect none
  deadline 5s
  implementation "worker.jobTick"
}
operation job viewedJob {
  input { event: Text(1..4096) }
  output { count: Int(0..10) }
  allow actor != null
  effect none
  deadline 5s
  implementation "worker.jobViewed"
}
operation job nestedJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access jobs.incrementJob, Video.increment
  effect managed
  deadline 10s
  implementation "worker.jobNested"
}

// One outbound HTTP call that is journaled, so a retry after it completed replays the answer instead of sending again.
operation job mailJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access http.mail
  effect managed
  deadline 5s
  implementation "worker.jobMail"
}

// A journaled event: the retry after the publish committed replays the cursor and appends nothing.
operation job eventJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access events.audit
  effect managed
  deadline 5s
  implementation "worker.jobEvent"
}

// A journaled message: the retry after the publish committed replays the message and enqueues nothing.
operation job messageJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access messages.orders
  effect managed
  deadline 5s
  implementation "worker.jobMessage"
}

// Started by a signed webhook as the service principal: publishes one message into the service principal's own queue scope.
operation job relayJob {
  input { body: Text(1..4096) }
  output { count: Int(0..10) }
  allow actor != null
  access messages.orders
  effect managed
  deadline 5s
  implementation "worker.jobRelay"
}
// The message handler's job: the server turns each ready message of the queue into one of these.
operation job handleJob {
  input { message: Text(1..8192) }
  output { count: Int(0..10) }
  allow actor != null
  effect managed
  deadline 5s
  implementation "worker.jobHandle"
}

// A journaled file: the retry after the put committed replays the file and stores nothing more, and the job reads it back.
operation job fileJob {
  input { id: Video.Id }
  output { count: Int(0..10) }
  allow actor != null
  access files.docs
  effect managed
  deadline 5s
  implementation "worker.jobFile"
}
