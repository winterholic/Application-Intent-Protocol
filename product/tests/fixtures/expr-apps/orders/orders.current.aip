// 주문·재고 앱, 1.0 현재 문법(4e132564+표현력 설계 브랜치 기준). P0 기능이 들어올 자리는 `P0-A/B/C` 표지로 남긴다.
actor Member
resource Member { fields { id: Id; name: Text(1..50) } rows read when id = actor }

resource Product {
  fields { id: Id; sku: Text(1..40); stock: Int(0..1000000); price: Int(0..1000000) }
  rows read when actor != null
  // 선언만으로 되는 부분: 고정 1개 차감(`stock = stock - 1`). 음수가 되는 요청은 from이 막는다.
  transition takeOne { allow actor != null; from stock >= 1; to stock = stock - 1 }
  // P0-B 자리: 입력 수량 차감 `input { qty }; from stock >= input.qty; to stock = stock - input.qty`가 아직 없어,
  // 확장이 읽고 계산해 이 전이로 쓴다(patch + expect = 낙관적 잠금). internal이라 호출자가 직접 부를 수 없다.
  transition setStock { allow actor != null; from true; patch stock; expect stock }
  expose read { select id, sku, stock, price; filter id.eq, sku.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose apply takeOne { target id; bulk maxRows 1 }
  expose apply setStock { target id; bulk maxRows 1; internal }
}

resource Order {
  fields { id: Id; owner: Member; total: Int(0..1000000000); placed: Bool }
  rows read when owner = actor
  transition finish { allow owner = actor; from placed = false; patch total; to placed = true }
  expose read { select id, total, placed; filter id.eq, placed.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  // P0-A 자리: 지금은 부모를 먼저 만들고(아래 create), 그 id로 줄을 만든 뒤(OrderLine create), 확장이 확정한다.
  expose create { allow owner = actor and placed = false and total = 0; fields owner, total, placed }
  expose apply finish { target id; bulk maxRows 1; internal }
  extension write place {
    input { id: Order.Id }
    output { id: Order.Id; total: Int }
    access read.OrderLine, read.Product, Product.setStock, Order.finish
    effect db
    deadline 3s
    implementation "shop.place"
  }
}

resource OrderLine {
  fields { id: Id; order: Order; product: Product; qty: Int(1..1000); unitPrice: Int(0..1000000) }
  rows read when order.owner = actor
  expose read { select id, qty, unitPrice, product; filter order.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow order.owner = actor and order.placed = false; fields order, product, qty, unitPrice }
}
