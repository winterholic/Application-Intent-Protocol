// FaceReview relational models over the original MySQL schema (WBS 7.2.3). Reads only; writes come with 7.2.2/7.2.4.
// The original app fills created_at/updated_at in Python, so the business tables need DB defaults before adoption
// (see fr-port/db-defaults.sql); `default database` is checked against the live catalog at adoption.
actor User

// The original's admin_required: ADMIN and SUPER_ADMIN, judged from the caller's own row.
predicate isAdmin(a: User) = a.role in (ADMIN, SUPER_ADMIN) and a.is_deleted = false
// A deactivated member (is_deleted) is no longer a valid caller; NULL counts as deactivated, as filter_by(is_deleted=False) does.
predicate active(a: User) = a.is_deleted = false

access activeUserOrGuest(a: User) = true
// The original's admin_required, for counts and totals only an administrator may ask for.
access adminOnly(a: User) = isAdmin(a)

enum Role { GENERAL, ADMIN, SUPER_ADMIN }
enum Genre { drama, eating, travel, cook, show, information, game, sports, music, animal, beauty, comedy, horror, exercise, vlog, etc }
enum RequestStatus { PENDING, ACCEPTED, REJECTED }
enum SearchKeywordType { all, title, channel_name }
enum ListEmotion { all, happy, sad, neutral, surprise, angry }

resource User {
  fields {
    id: Uuid
    email: Text(1..255)
    name: Text(1..50)
    role: Role
    profile_image_id: Int(0..1000000)?
    is_tutorial_done: Bool?
    is_verify_email_done: Bool?
    is_deleted: Bool?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when (id = actor and active(actor)) or isAdmin(actor)
  // SUPER_ADMIN may deactivate anyone, ADMIN only a GENERAL member; the member's comments are hidden in the same transaction.
  transition deactivate {
    allow actor.role = SUPER_ADMIN or (actor.role = ADMIN and role = GENERAL)
    from true
    to is_deleted = true, updated_at = now
    update many Comment maxRows 1000 where user = this.id { is_deleted = true; updated_at = now }
    repeat unchanged
  }
  transition changeRole {
    allow actor.role = SUPER_ADMIN
    from is_deleted = false
    patch role
    to updated_at = now
  }
  // 회원 본인 탈퇴 (원본 MypageService.withdraw_user 대응 — 5개 테이블 물리 삭제 + 댓글 soft delete)
  transition withdraw {
    allow id = actor and active(actor)
    from is_deleted = false
    to is_deleted = true, updated_at = now
    update many Comment maxRows 1000 where user = this.id { is_deleted = true; updated_at = now }
    delete many VideoLike maxRows 1000 where user = this.id
    delete many VideoViewLog maxRows 1000 where user = this.id
    delete many VideoRequest maxRows 1000 where user = this.id
    delete many UserFavoriteGenre maxRows 1000 where user = this.id
    delete many UserPointHistory maxRows 1000 where user = this.id
  }
  // AuthService.complete_tutorial: a second call leaves the row as it is.
  transition completeTutorial {
    allow id = actor and active(actor)
    from true
    to is_tutorial_done = true, updated_at = now
    repeat unchanged
  }
  // MypageService.update_profile for the member's own row: the name and the profile image, each only when the caller sends it. The favorite genres
  // are rows of UserFavoriteGenre (remove the old ones and create the new ones in the same bundle).
  transition updateProfile {
    allow id = actor and active(actor)
    from is_deleted = false
    patch name, profile_image_id
    to updated_at = now
  }
  expose apply deactivate { target id; bulk maxRows 1 }
  expose apply withdraw { target id; bulk maxRows 1 }
  expose apply completeTutorial { target id; bulk maxRows 1 }
  expose apply updateProfile { target id; bulk maxRows 1 }
  expose apply changeRole { target id; bulk maxRows 1 }
  expose read {
    select id, email, name, role, profile_image_id, is_tutorial_done, is_verify_email_done, is_deleted, created_at, watchCount, commentCount
    filter id.eq, role.eq, is_deleted.eq, name.contains, email.contains, name.like, email.like
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
  // AdminService.get_users counts every view-log row and every comment (deleted ones too) of the member.
  aggregate watchCount: Int {
    source VideoViewLog
    sourceAccess activeUserOrGuest(actor)
    groupKey user
    callerFilter none
    rowOutput none
    release count
  }
  aggregate commentCount: Int {
    source Comment
    sourceAccess activeUserOrGuest(actor)
    groupKey user
    callerFilter none
    rowOutput none
    release count
  }
  aggregate totalCount: Int {
    source User
    sourceAccess adminOnly(actor)
    where isAdmin(actor)
    callerFilter read
    rowOutput none
    release count
  }
  expose aggregate totalCount
}

resource Video {
  fields {
    id: Uuid
    youtube_url: Text(1..50)
    title: Text(1..255)
    channel_name: Text(1..100)?
    category: Genre
    duration: Int(0..1000000)?
    view_count: Int(0..1000000000) default database
    is_deleted: Bool?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when is_deleted = false and (actor = null or active(actor))
  transition remove {
    allow isAdmin(actor)
    from true
    to is_deleted = true, updated_at = now
    repeat unchanged
  }
  // The original's `video.view_count += 1` inside GET watch/video. A read cannot write, so the caller applies this after the
  // detail read (the original answers with the count from before the increment). The column is NOT NULL after db-defaults.sql, so the
  // original's 500 on a NULL count cannot happen here.
  transition view {
    allow actor = null or active(actor)
    from is_deleted = false
    to view_count = this.view_count + 1, updated_at = now
  }
  expose apply remove { target id; bulk maxRows 1 }
  expose apply view { target id; bulk maxRows 1 }
  // The original's YoutubeTrendingJob._save_video and YoutubeCategoryFillJob._save_video, and the approval of a video request (7.2.9):
  // an administrator (the service principal of the collection jobs) registers a video as active. view_count and the timestamps come
  // from the database defaults; the unique youtube_url answers WIRE.ALREADY_EXISTS for a video the service already has.
  expose create {
    fields youtube_url, title, channel_name, category, duration, is_deleted
    allow isAdmin(actor)
  }
  expose read {
    select id, youtube_url, title, channel_name, category, duration, view_count, created_at, likeCount, commentCount
    filter id.eq, id.in, category.eq, title.like, channel_name.like, youtube_url.eq, youtube_url.in
    sort created_at, id, view_count
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000; cursor }
  }
  // The original counts likes and visible comments for every caller (watch detail, pool scoring); row policies of
  // VideoLike (own rows only) and Comment (admin sees deleted) do not apply to a public count.
  aggregate likeCount: Int {
    source VideoLike
    sourceAccess activeUserOrGuest(actor)
    groupKey video
    callerFilter none
    rowOutput none
    release count
  }
  aggregate commentCount: Int {
    source Comment
    sourceAccess activeUserOrGuest(actor)
    where is_deleted = false
    groupKey video
    callerFilter none
    rowOutput none
    release count
  }
  aggregate totalCount: Int {
    source Video
    sourceAccess activeUserOrGuest(actor)
    // Match the list's row policy explicitly; standalone aggregates do not inherit it.
    where is_deleted = false and (actor = null or active(actor))
    callerFilter read
    rowOutput none
    release count
  }
  expose aggregate totalCount

  // Home and watch lists that need MongoDB (emotion distributions, watch sessions). Output lists are JSON text because extension
  // output accepts scalars only. Source: new-facereview@7948b7e7 HomeService / WatchService; see extensions/README.md.
  extension read homeSearch {
    input { page: Int(1..100000); size: Int(1..100); keyword_type: SearchKeywordType; keyword: Text; emotions: Text }
    output { videos: Text; total: Int(0..1000000000); page: Int(1..100000); size: Int(1..100); has_next: Bool }
    access mongo.video_distribution
    effect none
    deadline 20s
    implementation "slice13b_lists.homeSearch"
  }
  extension read homeVideoAll {
    input { page: Int(1..100000); size: Int(1..100); emotion: ListEmotion }
    output { videos: Text; total: Int(0..1000000000); page: Int(1..100000); size: Int(1..100); has_next: Bool }
    access mongo.video_distribution
    effect none
    deadline 20s
    implementation "slice13b_lists.homeVideoAll"
  }
  extension read homeBookmark {
    input { page: Int(1..100000); size: Int(1..100); emotion: ListEmotion }
    output { videos: Text; total: Int(0..1000000000); page: Int(1..100000); size: Int(1..100); has_next: Bool }
    access mongo.video_distribution
    effect none
    deadline 20s
    implementation "slice13b_lists.homeBookmark"
  }
  extension read homeCategory {
    input { }
    output { categories: Text }
    access mongo.video_distribution, redis "facereview:reco:*"
    effect none
    deadline 30s
    implementation "slice13d_recommend.homeCategory"
  }
  extension read homePersonalized {
    input { }
    output { videos: Text }
    access mongo.video_distribution, mongo.youtube_watching_data, redis "facereview:reco:*"
    effect none
    deadline 30s
    implementation "slice13d_recommend.homePersonalized"
  }
  extension read watchRecommended {
    input { video_id: Video.Id; page: Int(1..100000); size: Int(1..100) }
    output { videos: Text; total: Int(0..1000000000); page: Int(1..100000); size: Int(1..100); has_next: Bool }
    access mongo.video_distribution
    effect none
    deadline 20s
    implementation "slice13d_recommend.watchRecommended"
  }
  // GET watch/video: the detail with the all-viewer emotion timeline. The timeline is a server-side aggregate (`mongo.video_emotion_timeline`
  // derives the 100 buckets; no session document is readable through it). The view count is not incremented here; see `view`.
  extension read watchDetail {
    input { video_id: Video.Id }
    output {
      video_id: Text; youtube_url: Text; title: Text; channel_name: Text; category: Text
      duration: Int(0..1000000)?; view_count: Int(0..1000000000); like_count: Int(0..1000000000); comment_count: Int(0..1000000000)
      user_is_liked: Bool; is_bookmarked: Bool; timeline_data: Text
    }
    access mongo.video_emotion_timeline
    effect none
    deadline 20s
    implementation "slice13f_watch.watchDetail"
  }
}

resource Comment {
  fields {
    id: Uuid
    video: Video
    user: User
    content: Text(1..500)
    is_modified: Bool?
    is_deleted: Bool?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when (is_deleted = false and video.is_deleted = false and (actor = null or active(actor))) or isAdmin(actor)
  transition edit {
    allow user = actor and active(actor)
    from is_deleted = false
    patch content
    to is_modified = true, updated_at = now
  }
  transition delete {
    allow user = actor and active(actor)
    from is_deleted = false
    to is_deleted = true, updated_at = now
  }
  expose create {
    fields video, user, content
    allow user = actor and active(actor) and video.is_deleted = false
  }
  transition remove {
    allow isAdmin(actor)
    from true
    to is_deleted = true, updated_at = now
    repeat unchanged
  }
  expose apply edit { target id; bulk maxRows 1 }
  expose apply delete { target id; bulk maxRows 1 }
  expose apply remove { target id; bulk maxRows 1 }
  expose read {
    select id, video, user, content, is_modified, is_deleted, created_at, updated_at
    refIds video, user
    filter id.eq, video.eq, is_deleted.eq, content.contains, content.like
    sort created_at, id
    traverse user { select id, name }
    traverse video { select id, title }
    budget { rows 100; depth 2; cost 2000; deadline 2s; offset 100000 }
  }
  aggregate totalCount: Int {
    source Comment
    sourceAccess adminOnly(actor)
    where isAdmin(actor)
    callerFilter read
    rowOutput none
    release count
  }
  expose aggregate totalCount
}

resource VideoLike {
  fields { id: Uuid; video: Video; user: User; created_at: Time default database }
  rows read when user = actor and active(actor)
  expose create {
    fields video, user
    allow user = actor and active(actor) and video.is_deleted = false
  }
  transition remove {
    allow user = actor and active(actor)
    from true
    delete
  }
  expose apply remove { target id; bulk maxRows 1 }
  expose read {
    select id, video, user, created_at
    refIds video, user
    filter video.eq
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
}

resource VideoBookmark {
  fields { id: Uuid; video: Video; user: User; created_at: Time default database }
  rows read when user = actor and active(actor)
  expose create {
    fields video, user
    allow user = actor and active(actor) and video.is_deleted = false
  }
  transition remove {
    allow user = actor and active(actor)
    from true
    delete
  }
  expose apply remove { target id; bulk maxRows 1 }
  expose read {
    select id, video, user, created_at
    refIds video, user
    filter video.eq, video.in
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
}

// The request's youtube_url already belongs to a registered video (the row policy of the caller applies to that look).
predicate hasVideo(r: VideoRequest) = exists Video where youtube_url = r.youtube_url

resource VideoRequest {
  fields {
    id: Uuid
    user: User
    youtube_url: Text(1..50)
    youtube_full_url: Text(1..255)
    status: RequestStatus default database
    admin_comment: Text(1..255)?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when (user = actor and active(actor)) or isAdmin(actor)
  transition reject {
    allow isAdmin(actor)
    from status = PENDING
    patch admin_comment
    to status = REJECTED, updated_at = now
  }
  // AdminService.approve_video_request ends here, after the job approveVideoRequest made the Video: the request can only become
  // ACCEPTED while a Video with its youtube_url exists, so a client cannot accept a request without registering the video.
  transition accept {
    allow isAdmin(actor)
    from status = PENDING and hasVideo(this)
    to status = ACCEPTED, updated_at = now
  }
  expose apply reject { target id; bulk maxRows 1 }
  expose apply accept { target id; bulk maxRows 1 }
  expose create {
    fields user, youtube_url, youtube_full_url
    allow user = actor and active(actor)
  }
  expose read {
    select id, user, youtube_url, youtube_full_url, status, admin_comment, created_at, updated_at
    refIds user
    filter id.eq, user.eq, status.eq
    sort created_at, id
    traverse user { select id, name }
    budget { rows 100; depth 2; cost 2000; deadline 2s; offset 100000 }
  }
  aggregate totalCount: Int {
    source VideoRequest
    sourceAccess adminOnly(actor)
    where isAdmin(actor)
    callerFilter read
    rowOutput none
    release count
  }
  expose aggregate totalCount
}

resource VideoViewLog {
  fields {
    id: Uuid
    video: Video
    user: User?
    guest_token: Text(1..255)?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when user = actor and active(actor)
  expose read {
    select id, video, user, created_at
    refIds video, user
    filter video.eq
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
}

resource UserFavoriteGenre {
  fields { id: Uuid; user: User; genre: Genre; created_at: Time default database; updated_at: Time default database }
  rows read when user = actor and active(actor)
  expose create {
    fields user, genre
    allow user = actor and active(actor)
  }
  transition remove {
    allow user = actor and active(actor)
    from true
    delete
  }
  expose apply remove { target id; bulk maxRows 16 }
  expose read {
    select id, user, genre, created_at
    refIds user
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
}

resource UserPointHistory {
  fields {
    id: Uuid
    user: User
    video: Video?
    amount: Int
    watch_time: Int(0..1000000)?
    description: Text(1..255)?
    created_at: Time default database
    updated_at: Time default database
  }
  rows read when user = actor and active(actor)
  expose read {
    select id, user, video, amount, watch_time, description, created_at
    refIds user, video
    filter video.eq
    sort created_at, id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 100000 }
  }
}

// 1:1 shared primary keys: id is the User FK and the table's PK at once.
resource UserEmotionDna {
  fields {
    id: User
    dna_type: Text(1..50)
    dna_data: Json
    based_on_videos: Int
    generated_at: Time
    expires_at: Time
  }
  rows read when id = actor and active(actor)
  expose read {
    select id, dna_type, dna_data, based_on_videos, generated_at, expires_at
    filter id.eq
    budget { rows 1; depth 1; cost 100; deadline 1s }
  }
}

resource UserEmotionSummary {
  fields {
    id: User
    neutral_seconds: Int
    happy_seconds: Int
    surprise_seconds: Int
    sad_seconds: Int
    angry_seconds: Int
    last_finalized_at: Time?
    last_session_id: Text(1..64)?
    lock_version: Int
    created_at: Time
    updated_at: Time
  }
  rows read when id = actor and active(actor)
  expose read {
    select id, neutral_seconds, happy_seconds, surprise_seconds, sad_seconds, angry_seconds,
      last_finalized_at, last_session_id, lock_version, created_at, updated_at
    filter id.eq
    budget { rows 1; depth 1; cost 100; deadline 1s }
  }
}

// WBS 7.2.7: the original's Celery beat task rebuild_recommendation_pool (every 30 minutes). A server schedule runs it as the service
// principal bound to an administrator; the reads go through that principal's own row policies, so the pool holds exactly what a member
// would see. The Redis keys are the original's (facereview:reco:*), written with their 7200 second expiry.
operation job rebuildRecommendationPool {
  input { }
  output { pool: Int(0..100000); categories: Int(0..100) }
  allow isAdmin(actor)
  access read.Video, mongo.video_distribution, redis "facereview:reco:*"
  effect managed
  deadline 120s
  implementation "slice14a_pool.rebuildRecommendationPool"
}

// WBS 7.2.7: the original's Celery beat task fetch_youtube_trending_videos (every day 06:00 Asia/Seoul). The integration youtube_videos
// is the server's GET endpoint of the YouTube Data API (query_params and secret_query_env in the service configuration).
operation job fetchTrendingVideos {
  input { }
  output { fetched: Int(0..1000); fresh: Int(0..1000); saved: Int(0..1000) }
  allow isAdmin(actor)
  access read.Video, create.Video, http.youtube_videos, mongo.video_distribution, mongo.video_timeline_emotion_count
  effect managed
  deadline 600s
  implementation "slice14b_trending.fetchTrendingVideos"
}

// WBS 7.2.7: the original's Celery beat task fill_youtube_category_videos (Tuesday and Friday 03:00 Asia/Seoul). It searches YouTube
// (youtube_search) for the genres that have the fewest active videos and saves what it finds. A run searches at most 12 times and each
// new video costs 3 ctx calls, so the service sets limits.job_calls to 1000 or more for it.
operation job fillCategoryVideos {
  input { }
  output { saved: Int(0..100000); searches: Int(0..100); quota: Int(0..1000000) }
  allow isAdmin(actor)
  access read.Video, create.Video, http.youtube_search, http.youtube_videos, mongo.video_distribution, mongo.video_timeline_emotion_count
  effect managed
  deadline 900s
  implementation "slice14c_category_fill.fillCategoryVideos"
}

// WBS 7.2.9: the original's AdminService.approve_video_request. The administrator chooses the video's title, channel, length and genre
// when approving; the job registers the Video with its two initial MongoDB documents and accepts the request. It runs in the background
// (the administrator reads the new video id from the job result) and a retry converges on what was already done.
operation job approveVideoRequest {
  input { request: VideoRequest.Id; youtube_title: Text(1..255); channel_name: Text(1..100); duration: Int(0..1000000); category: Genre }
  output { video_id: Video.Id }
  allow isAdmin(actor)
  access read.VideoRequest, read.Video, create.Video, VideoRequest.accept, mongo.video_distribution, mongo.video_timeline_emotion_count
  effect managed
  deadline 60s
  implementation "slice14d_approve.approveVideoRequest"
}
