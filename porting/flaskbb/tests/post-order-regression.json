  "pointer_rules": {
    "source": "upstream flaskbb/forum/models.py 291-331 Post._deal_with_last_post",
    "topic_last_updated": "ORM-observed (RED run 44017218587): Topic.last_post_id is assigned from posts[-2] but last_updated reads the stale loaded Topic.last_post relationship, so it equals the target Post date when a second-last Post exists (always for hide, remaining Posts>=2 for delete) and the first Post date otherwise; it is not the selected last_post date",
    "unordered": "Topic.posts[-2] has no ORDER BY; multi-candidate cases and any case whose Topic keeps the hidden target in the relationship assert allowed membership and last_updated consistency only",
    "forum_candidates": "upstream flaskbb/forum/models.py 298-319: Forum candidates are Post rows of the same Forum with Post.hidden != True and Post.id != target, Post.id desc; Topic.hidden is not filtered, so a visible Post of a hidden Topic is a candidate, and with no candidate last_post and the four projection fields are all NULL",
    "hide_delete": "Per-action maps ({hide, delete}) are allowed for last_post_one_of; hide keeps the hidden target in the loaded Topic.posts relationship (so posts[-2] exists with >=2 rows), delete removes it by autoflush before the relationship is read"
  },
