// Infisical MIT port, structure and authorization only (WBS 7.3.3.3/7.3.3.4, reworked after the independent
// verification of 2026-10-18). Upstream: Infisical 47246be (2026-10-17), MIT scope only.
//
// PRODUCT GAP, deliberately NOT worked around (plan-docs/porting/INFISICAL-GAPS.md, G2):
//   Secret VALUES are not declared here. The product service dialect rejects the `encrypted` field
//   modifier (DEF.PARSE_EXPECTED) and AIP_ENCRYPTION_KEYS exists only in the PoC runtime, so the only way to store a
//   value today is a plain Text column, which would keep secrets in clear text and expose them to every reader. The
//   previous draft did that under the name valueCiphertext; it was also unreadable (WIRE.FIELD_NOT_EXPOSED).
//   Secret value storage, value versions, rotation and blind-index lookups stay undeclared until the
//   an encryption design is approved and implemented (docs/design/13 is a Proposed draft that an independent
//   static review did not clear for implementation). Everything below is names, folders, membership and permissions.
//
// Behavior is checked on a real PostgreSQL by porting/infisical/tests/test_live_db.py. Declared jobs live only
// when a worker implements them (see the job section at the end).
enum OrgRole { ADMIN, MEMBER }
enum ProjectRole { ADMIN, MEMBER, VIEWER, NO_ACCESS }
actor User

// -- predicates ---------------------------------------------------------------------------------------------------
predicate isOrgMember(viewer: User?, targetOrg: Organization?) = viewer != null and targetOrg != null and exists OrgMembership where user = viewer and org = targetOrg
predicate isOrgAdmin(viewer: User?, targetOrg: Organization?) = viewer != null and targetOrg != null and exists OrgMembership where user = viewer and org = targetOrg and role = ADMIN
predicate orgHasNoMember(targetOrg: Organization?) = targetOrg != null and not exists OrgMembership where org = targetOrg
predicate sharesOrgWith(viewer: User?, other: User?) = viewer != null and other != null and exists OrgMembership where user = other and isOrgMember(viewer, org)
// Org admins reach every project of their org (draft decision, differs from upstream; see INFISICAL-GAPS.md G7).
predicate canReadProject(viewer: User?, targetProject: Project?) = viewer != null and targetProject != null and (isOrgAdmin(viewer, targetProject.org) or exists ProjectMembership where user = viewer and project = targetProject and role in (ADMIN, MEMBER, VIEWER))
predicate canWriteProject(viewer: User?, targetProject: Project?) = viewer != null and targetProject != null and (isOrgAdmin(viewer, targetProject.org) or exists ProjectMembership where user = viewer and project = targetProject and role in (ADMIN, MEMBER))
predicate isProjectAdmin(viewer: User?, targetProject: Project?) = viewer != null and targetProject != null and (isOrgAdmin(viewer, targetProject.org) or exists ProjectMembership where user = viewer and project = targetProject and role = ADMIN)

resource User {
  fields { id: Id; email: Text(3..200); username: Text(1..200)? }
  unique email
  // A user is visible to themselves and to members of an organization they share, never to the whole table.
  rows read when this = actor or sharesOrgWith(actor, this)
  expose read {
    select id, email, username
    filter id.eq, email.eq, username.prefix
    sort id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 1000; cursor }
  }
}

resource Organization {
  fields { id: Id; name: Text(1..100); slug: Text(1..100); createdBy: User }
  unique slug
  rows read when isOrgMember(actor, this) or createdBy = actor
  expose create {
    allow actor != null and createdBy = actor
    fields name, slug, createdBy
  }
  expose read {
    select id, name, slug
    filter id.eq, slug.eq, name.prefix
    sort id
    budget { rows 100; depth 1; cost 1000; deadline 2s; offset 500 }
  }
}

resource OrgMembership {
  fields { id: Id; user: User; org: Organization; role: OrgRole }
  unique user, org
  rows read when isOrgMember(actor, org)
  // The creator of an organization claims its first admin seat exactly once; afterwards only admins add members.
  expose create {
    allow isOrgAdmin(actor, org) or (user = actor and role = ADMIN and org.createdBy = actor and orgHasNoMember(org))
    fields user, org, role
  }
  transition setRole {
    allow isOrgAdmin(actor, org)
    from true
    patch role
  }
  expose apply setRole { target id; bulk maxRows 1 }
  expose read {
    select id, user, org, role
    filter user.eq, org.eq
    sort id
    traverse user { select id, email }
    budget { rows 1000; depth 2; cost 3000; deadline 2s; offset 2000 }
  }
}

resource Project {
  fields { id: Id; org: Organization; name: Text(1..100); slug: Text(1..100) }
  unique org, slug
  rows read when canReadProject(actor, this)
  expose create {
    allow isOrgAdmin(actor, org)
    fields org, name, slug
  }
  expose read {
    select id, org, name, slug
    filter id.eq, org.eq, slug.eq, name.prefix
    sort id
    traverse org { select id, slug }
    budget { rows 500; depth 2; cost 2000; deadline 2s; offset 1000 }
  }
}

resource ProjectMembership {
  fields { id: Id; user: User; project: Project; role: ProjectRole }
  unique user, project
  rows read when canReadProject(actor, project)
  expose create {
    allow isProjectAdmin(actor, project) and isOrgMember(user, project.org)
    fields user, project, role
  }
  transition setRole {
    allow isProjectAdmin(actor, project)
    from true
    patch role
  }
  expose apply setRole { target id; bulk maxRows 1 }
  expose read {
    select id, user, project, role
    filter user.eq, project.eq
    sort id
    traverse user { select id, email }
    budget { rows 1000; depth 2; cost 3000; deadline 2s; offset 2000 }
  }
}

// Every environment has a root folder with path "/", exactly like upstream. Secrets always live in a folder, so the
// (folder, key) uniqueness below has no NULL hole.
resource Folder {
  fields { id: Id; project: Project; path: Text(1..500); env: Text(1..64) }
  unique project, path, env
  rows read when canReadProject(actor, project)
  expose create {
    allow canWriteProject(actor, project)
    fields project, path, env
  }
  expose read {
    select id, project, path, env
    filter id.eq, project.eq, path.prefix, env.eq
    sort path, id
    traverse project { select id, slug }
    budget { rows 1000; depth 2; cost 3000; deadline 2s; offset 2000 }
  }
}

// One shared secret: a name in a folder. Upstream keeps the same shape in secrets_v2 and enforces one shared secret
// per (key, folder) with the partial unique index uq_secrets_v2_key_folder_id_shared
// (backend/src/db/migrations/20260623144551_secret-folder-unique-index.ts), and deleteMany removes the row for real
// (backend/src/services/secret-v2-bridge/secret-v2-bridge-dal.ts, deleteMany). Personal overrides (type = personal)
// and the value columns are not modelled here (value: G2 in plan-docs/porting/INFISICAL-GAPS.md).
resource Secret {
  fields { id: Id; folder: Folder; key: Text(1..500); owner: User; remindedAt: Time? }
  unique folder, key
  rows read when canReadProject(actor, folder.project)
  docs { summary "비밀 하나(폴더 안의 이름). 값 저장은 encrypted 수정자 제품 갭(G2)으로 선언하지 않음"; visibility internal }
  expose create {
    allow canWriteProject(actor, folder.project) and owner = actor
    fields folder, key, owner
  }
  // Physical delete like upstream: the row is gone and the name can be created again.
  transition delete {
    allow canWriteProject(actor, folder.project)
    from true
    delete
  }
  expose apply delete { target id; bulk maxRows 100 }
  // Reminder record for the owner (an outbox notification, not a delivered mail).
  transition remind {
    allow canReadProject(actor, folder.project)
    from true
    to remindedAt = now
    repeat unchanged
    notify owner "secret.reminder"
  }
  expose apply remind { target id; bulk maxRows 1 }
  expose read {
    select id, folder, key, owner, remindedAt
    filter id.eq, folder.eq, key.eq, key.prefix, owner.eq
    sort key, id
    traverse folder { select id, path, env }
    budget { rows 500; depth 2; cost 3000; deadline 2s; offset 2000 }
  }
}

// -- jobs ---------------------------------------------------------------------------------------------------------
// Only jobs with a worker implementation are declared. The other MIT BullMQ queues are mapped in
// plan-docs/porting/INFISICAL-JOBS.md as "declared only" (no served operation, so nothing can enqueue a job
// that fails with EXTENSION_ERROR). The queue's reminder delivery itself (mail/Slack) is out of scope:
// this job records the reminder as an outbox notification through the declared Secret.remind transition.
operation job secretReminder {
  input { secret: Secret.Id }
  output { reminded: Int }
  allow actor != null and exists Secret where id = input.secret and canReadProject(actor, folder.project)
  access read.Secret, Secret.remind
  effect managed
  deadline 30s
  implementation "infisical_jobs.secret_reminder"
}
