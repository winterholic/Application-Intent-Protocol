# Generated executable bundles; keep small verification/provenance records
/product/dist/*/*
!/product/dist/*/README.md
!/product/dist/*/SHA256SUMS
!/product/dist/*/SOURCE_SHA256SUMS
/prototype/dist/*/*
!/prototype/dist/*/README.md
!/prototype/dist/*/manifest.json
