resource Member { fields { id: Id } }
actor Member
resource Event {
 fields { id: Id; member: Member; checked: Bool }
 rows read when member = actor
 transition mark { allow member = actor; from checked = false; to checked = true }
 transition other { allow member = actor; from checked = true; to checked = false }
 expose read { select id, checked; filter id.eq; sort id; budget { rows 10; depth 1; deadline 1s; cost 100 } }
 expose apply mark { target id; bulk maxRows 2 }
 expose apply other { target id; bulk maxRows 2 }
 extension write keyed { input { id: Event.Id } output { ok: Bool } access Event.mark effect db deadline 2s implementation "dx.keyed" }
 extension write noAccess { input { id: Event.Id } output { ok: Bool } access Event.mark effect db deadline 2s implementation "dx.no_access" }
 extension write badFilter { input { id: Event.Id } output { ok: Bool } access read.Event, Event.mark effect db deadline 2s implementation "dx.bad_filter" }
 extension write gate { input { id: Event.Id } output { ok: Bool } access read.Event, Event.other effect db deadline 2s implementation "dx.gate" }
 extension write crashes { input { id: Event.Id } output { ok: Bool } access Event.mark effect db deadline 2s implementation "dx.crashes" }
}
