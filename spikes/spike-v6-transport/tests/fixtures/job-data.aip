resource Member { fields { id: Id } }
actor Member
resource Order {
 fields { id: Id; member: Member; paid: Bool }
 rows read when member = actor
 transition pay { allow member = actor; from paid = false; to paid = true }
 expose read { select id, paid; sort id; budget { rows 10; depth 1; deadline 1s; cost 100 } }
 expose apply pay { target id; bulk maxRows 5 }
}
operation job settle {
  input { other: Order.Id }
  output { paid: Int; visible: Int; denied: Text; replayed: Bool }
  allow actor != null
  access read.Order, Order.pay
  effect managed
  deadline 10s
  implementation "data.settle"
}
operation job sneaky {
  input {}
  output { paid: Int }
  allow actor != null
  access read.Order
  effect managed
  deadline 10s
  implementation "data.sneaky"
}
operation job crashy {
  input {}
  output { seenPaid: Bool; changed: Int }
  allow actor != null
  access read.Order, Order.pay
  effect managed
  deadline 10s
  implementation "data.crashy"
}
