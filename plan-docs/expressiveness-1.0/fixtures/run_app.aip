actor Member
resource Member { fields { id: Id } rows read when id = actor }
resource Order {
  fields { id: Id; owner: Member; total: Int(0..1000000) }
  rows read when owner = actor
  expose read { select id, total; filter id.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow owner = actor; fields owner, total }
}
resource OrderLine {
  fields { id: Id; order: Order; qty: Int(1..1000) }
  rows read when order.owner = actor
  expose read { select id, qty; filter order.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow order.owner = actor; fields order, qty }
}
resource Todo {
  fields { id: Id; owner: Member; title: Text(1..100); done: Bool }
  rows read when owner = actor
  transition complete { allow owner = actor; from done = false; to done = true }
  expose read { select id, title, done; filter id.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow owner = actor; fields owner, title, done }
  expose apply complete { target id; bulk maxRows 1; internal }
  extension write completeAndRepeat {
    input { id: Todo.Id }
    output { next: Todo.Id }
    access read.Todo, Todo.complete, create.Todo
    effect db
    deadline 2s
    implementation "todo.completeAndRepeat"
  }
}
