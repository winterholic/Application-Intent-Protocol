actor Member
resource Member { fields { id: Id; name: Text(1..50) } rows read when id = actor
  expose read { select id, name; filter id.eq; sort id; budget { rows 10; depth 1; deadline 1s; cost 100 } } }

resource Product {
  fields { id: Id; sku: Text(1..40); stock: Int(0..1000000); price: Decimal(12,2) }
  rows read when actor != null
  transition take {
    input { qty: Int(1..1000) }
    allow actor != null
    from stock >= input.qty
    to stock = stock - input.qty
  }
  transition restock {
    input { amount: Decimal(12,2) }
    allow actor != null
    from true
    to price = price + input.amount
  }
  expose read { select id, sku, stock, price; filter id.eq, sku.eq, price.gte; sort id, price; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose apply take { target id; bulk maxRows 1 }
  expose apply restock { target id; bulk maxRows 1 }
}

resource Order {
  fields { id: Id; owner: Member; total: Decimal(14,2); status: Text(1..12) }
  rows read when owner = actor
  transition confirm { from status = "open"; allow owner = actor; to status = "confirmed" }
  expose read { select id, total, status, lineSum, lineCount; filter id.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow owner = actor; fields owner, total, status }
  expose apply confirm { target id; bulk maxRows 5 }
  expose compose { bulk maxRows 5; transitions confirm; create Note from owner }
  aggregate lineSum: Decimal(18,2) { source OrderLine; sourceAccess orderLines; groupKey order; callerFilter none; rowOutput none; release sum(amount) }
  aggregate lineCount: Int { source OrderLine; sourceAccess orderLines; where amount >= "0.00"; groupKey order; callerFilter none; rowOutput none; release count }
}
access orderLines = totalOfVisible(Order)

resource OrderLine {
  fields { id: Id; order: Order; product: Product; qty: Int(1..1000); amount: Decimal(12,2) }
  rows read when order.owner = actor
  expose read { select id, qty, amount, product; filter order.eq; sort id; budget { rows 50; depth 1; deadline 1s; cost 100 } }
  expose create { allow order.owner = actor; fields order, product, qty, amount }
}

resource Note {
  fields { id: Id; owner: Member; text: Text(1..20)? }
  rows read when owner = actor
  expose create { allow owner = actor; fields owner, text }
}
